  <!-- S-6 A4b: HLSL bytecode freshness.
       Runs for EVERY configuration, before every build. It does not compile
       anything - it verifies that each committed
       platform/Windows/src.Windows/Render/Generated/*Bytecode.h still matches
       the .hlsl it was generated from, by CONTENT HASH (git does not preserve
       mtimes, so a timestamp would fail or pass depending on checkout order).
       Editing a shader without regenerating FAILS the build here, which is the
       one thing that must not slip through silently.
       A header that is still a PLACEHOLDER only warns: an OpenGL-only Windows
       build compiles none of the D3D sources and must not be broken by a stub
       it never reads. A D3D build shipping stubs is caught by the BACKEND,
       which refuses to initialise on a zero-length shader - the only place that
       knows whether D3D is enabled at all.
       powershell.exe, not pwsh: 5.1 ships with Windows and the script needs
       nothing newer. -->
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\..\..\tools\embed-hlsl-shaders.ps1" -Check</Command>
      <Message>Checking HLSL bytecode headers are up to date with their sources</Message>
    </PreBuildEvent>
