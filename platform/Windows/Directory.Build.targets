<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- ===================================================================
       THE VISUAL STUDIO IDE CHANNEL.

       WHY A TARGET AND NOT AN IMPORT.

       MSBuild evaluates <Import> during project EVALUATION, which completes
       strictly before any target executes. So a Visual Studio build - which
       passes no /p:MTOutRoot - cannot import the generated .props for the build
       it is in, and the design originally accepted that: the IDE stopped at a
       guard naming build-windows.ps1, and only that script could produce a
       capability-correct binary.

       The way around it is not to import at all. A TARGET running
       BeforeTargets="ClCompile" can modify ClCompile ITEM METADATA, because
       those items are read by the ClCompile task at EXECUTION time, long after
       evaluation is over. That sidesteps the constraint entirely rather than
       working around it, and it makes F5 and a Release build from inside Visual
       Studio produce the same binary build-windows.ps1 does.

       WHY IT READS A FLAT FILE.

       MSBuild property functions are a whitelist of static .NET methods.
       File::ReadAllText is on it; parsing XML is not. So mtcaps writes
       ide-defines-{app,engine}.txt - semicolon-separated, exactly what goes into
       <PreprocessorDefinitions>, nothing to parse.

       WHICH APP.

       $(MTCapsApp) crosses the ProjectReference through <AdditionalProperties>,
       which is a PROJECT-FILE mechanism and therefore works in an IDE build too
       - unlike a command-line setting. The app's manifest is then found at the
       sibling layout the whole programme already assumes.

       UNVERIFIED. Nothing here has been executed: there is no MSBuild on the
       machine this was written on. It is reasoned from documented behaviour, and
       a first MSBuild run on Windows is what confirms or refutes it.
       =================================================================== -->

  <Target Name="MTCapsResolveForIDE"
          BeforeTargets="ClCompile"
          Condition="'$(MTOutRoot)' == '' And '$(MT_STANDALONE)' != '1'">

    <!-- The engine is built as a ProjectReference from an app's solution, so the
         app's identity arrives in $(MTCapsApp) and its repo is a sibling of this
         one. Without an app there is nothing to resolve - that is a bare engine
         build, which is what MT_STANDALONE=1 is for. -->
    <!-- BUILD SOLUTION, not just Build Project. An app .sln lists
         MTEngineSDL.vcxproj as a solution project too, so Visual Studio builds
         it once standalone (no AdditionalProperties, hence no MTCapsApp) as
         well as through the app's ProjectReference. The standalone pass used to
         hit the guard below and fail the whole solution build.

         The solution itself carries the missing context: every app keeps its
         .sln at <app>\platform\Windows\, so $(SolutionDir)..\.. is the app repo
         and its mtengine-app.conf names the app. Reading it here is what makes
         Build Solution work. When the app arrives normally (ProjectReference,
         or the command-line driver) MTCapsApp is already set and none of this
         runs; when the ENGINE's own solution is built, that conf does not
         exist, the guard still fires, and MT_STANDALONE=1 is still the answer
         for a bare engine build.

         ReadLinesFromFile and not a Regex property function: parsing XML or
         chaining a Match through .Groups is outside what MSBuild's property
         functions do reliably, and this file already learned that lesson with
         ide-defines-*.txt. -->
    <PropertyGroup Condition="'$(MTCapsApp)' == '' And '$(SolutionDir)' != ''">
      <MTCapsSolutionAppDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\..'))</MTCapsSolutionAppDir>
      <MTCapsSolutionConf>$(MTCapsSolutionAppDir)\mtengine-app.conf</MTCapsSolutionConf>
    </PropertyGroup>
    <ReadLinesFromFile File="$(MTCapsSolutionConf)"
                       Condition="'$(MTCapsSolutionConf)' != '' And Exists('$(MTCapsSolutionConf)')">
      <Output TaskParameter="Lines" ItemName="MTCapsConfLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <MTCapsAppNameLine Include="@(MTCapsConfLine)"
                         Condition="$([System.String]::Copy('%(Identity)').StartsWith('MT_APP_NAME='))" />
    </ItemGroup>
    <PropertyGroup>
      <MTCapsAppNameRaw>@(MTCapsAppNameLine)</MTCapsAppNameRaw>
      <MTCapsApp Condition="'$(MTCapsApp)' == '' And '$(MTCapsAppNameRaw)' != ''">$(MTCapsAppNameRaw.Substring(12).Trim())</MTCapsApp>
    </PropertyGroup>
    <Message Condition="'$(MTCapsSolutionAppDir)' != '' And '$(MTCapsApp)' != ''"
             Importance="high"
             Text="Capabilities (IDE): app taken from the solution -&gt; $(MTCapsApp)" />
    <Error Condition="'$(MTCapsApp)' == ''"
           Text="This engine build has no app context: neither /p:MTOutRoot nor MTCapsApp is set, so there is no manifest to resolve. Build the app's project (which references this one), run its build-windows.ps1, or pass /p:MT_STANDALONE=1 for a bare engine build." />

    <PropertyGroup>
      <MTCapsEngineDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</MTCapsEngineDir>
      <MTCapsAppDir>$([System.IO.Path]::GetFullPath('$(MTCapsEngineDir)\..\$(MTCapsApp)'))</MTCapsAppDir>
      <MTCapsManifest>$(MTCapsAppDir)\mtengine.caps</MTCapsManifest>
    </PropertyGroup>

    <Error Condition="!Exists('$(MTCapsManifest)')"
           Text="No manifest at $(MTCapsManifest) for MTCapsApp=$(MTCapsApp). The four apps are expected as siblings of the engine checkout." />

    <!-- `py -3` where it exists, `python` otherwise. Never a bare guess: the
         interpreter rule is the same one the build scripts follow, and cmd.exe's
         && / || is the shortest way to express it in one Exec. -->
    <!-- The llama.cpp backend, as an ENGINE OPTION rather than a capability.
         MT_LLAMA_CUDA selects a materially different archive under an identical
         capability set, which is exactly what resolve.backend_hash exists for,
         and the backend component keys both $MT_OUT and the dependency
         directory. The command line has -SkipCuda to read; the IDE has only
         $(Platform), and ARM64 never gets CUDA, which is the same rule
         build-deps.ps1 already writes as
         -SkipCuda:($SkipCuda -or ($Platform -eq 'ARM64')).

         IT MUST MATCH WHAT build-windows.ps1 PASSES. An IDE build that disagrees
         with the command line on the backend resolves a different directory and
         links archives no phase of that build wrote.

         (No double hyphen appears in this comment on purpose: XML forbids one
         inside a comment, and the first draft of this block was not well formed
         because it spelled the option flags out.) -->
    <PropertyGroup>
      <MTCapsCuda Condition="'$(Platform)' == 'ARM64'">OFF</MTCapsCuda>
      <MTCapsCuda Condition="'$(MTCapsCuda)' == ''">ON</MTCapsCuda>
      <MTCapsResolveArgs>--manifest &quot;$(MTCapsManifest)&quot; --app $(MTCapsApp) --platform windows --arch $(Platform) --config $(Configuration) --engine-dir &quot;$(MTCapsEngineDir)&quot; --engine-option MT_LLAMA_CUDA=$(MTCapsCuda)</MTCapsResolveArgs>
    </PropertyGroup>

    <Exec Command="where py &gt;nul 2&gt;&amp;1 &amp;&amp; (py -3 -B &quot;$(MTCapsEngineDir)\tools\mtcaps\mtcaps.py&quot; resolve $(MTCapsResolveArgs) --print out-dir) || (python -B &quot;$(MTCapsEngineDir)\tools\mtcaps\mtcaps.py&quot; resolve $(MTCapsResolveArgs) --print out-dir)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="MTCapsResolvedRoot" />
    </Exec>

    <Error Condition="'$(MTCapsResolvedRoot)' == ''"
           Text="mtcaps resolve produced no output root for $(MTCapsManifest)." />

    <!-- The dependency-archive directory. A SECOND resolve invocation asking for
         one bare value, rather than a parse of the multi-line form, because
         MSBuild joins a task's whole stdout into one ';'-separated property.
         That is why the one-bare-value print mode exists at all. Identical
         arguments, so the two invocations cannot disagree on the backend. -->
    <Exec Command="where py &gt;nul 2&gt;&amp;1 &amp;&amp; (py -3 -B &quot;$(MTCapsEngineDir)\tools\mtcaps\mtcaps.py&quot; resolve $(MTCapsResolveArgs) --print deps-dir) || (python -B &quot;$(MTCapsEngineDir)\tools\mtcaps\mtcaps.py&quot; resolve $(MTCapsResolveArgs) --print deps-dir)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="MTCapsLibsDir" />
    </Exec>

    <Error Condition="'$(MTCapsLibsDir)' == ''"
           Text="mtcaps resolve produced no dependency directory for $(MTCapsManifest)." />

    <!-- L9: the rev-free build root for compiled objects. Same
         one-bare-value pattern, same arguments. -->
    <Exec Command="where py &gt;nul 2&gt;&amp;1 &amp;&amp; (py -3 -B &quot;$(MTCapsEngineDir)\tools\mtcaps\mtcaps.py&quot; resolve $(MTCapsResolveArgs) --print build-dir) || (python -B &quot;$(MTCapsEngineDir)\tools\mtcaps\mtcaps.py&quot; resolve $(MTCapsResolveArgs) --print build-dir)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="MTBuildRoot" />
    </Exec>
    <PropertyGroup>
      <MTBuildRoot Condition="'$(MTBuildRoot)' != '' And !HasTrailingSlash('$(MTBuildRoot)')">$(MTBuildRoot)\</MTBuildRoot>
    </PropertyGroup>

    <PropertyGroup>
      <MTCapsDefinesFile>$(MTCapsResolvedRoot)\ide-defines-engine.txt</MTCapsDefinesFile>
    </PropertyGroup>

    <Error Condition="!Exists('$(MTCapsDefinesFile)')"
           Text="mtcaps resolve reported $(MTCapsResolvedRoot) but wrote no ide-defines-engine.txt there." />

    <PropertyGroup>
      <MTCapsIdeDefines>$([System.IO.File]::ReadAllText('$(MTCapsDefinesFile)').Trim())</MTCapsIdeDefines>
      <MTCapsIdeDefinesUnescaped>$([MSBuild]::Unescape($([System.IO.File]::ReadAllText('$(MTCapsDefinesFile)').Trim())))</MTCapsIdeDefinesUnescaped>
      <!-- L9: the generated headers (MT_Capabilities.h, Sci/) live under the
           REV-FREE build root, not the rev-keyed out root. MTBuildRoot is
           already resolved by the third Exec above; naming MTCapsResolvedRoot
           here pointed at a directory that does not exist, so an IDE build got
           no MT_Capabilities.h. The second line keeps the old value as a
           fallback if that Exec produced nothing. -->
      <MTCapsIncludeDir Condition="'$(MTBuildRoot)' != ''">$(MTBuildRoot)include</MTCapsIncludeDir>
      <MTCapsIncludeDir Condition="'$(MTCapsIncludeDir)' == ''">$(MTCapsResolvedRoot)\include</MTCapsIncludeDir>
    </PropertyGroup>

    <Message Importance="high"
             Text="Capabilities (IDE): $(MTCapsApp) -&gt; $(MTCapsResolvedRoot)" />
    <Message Importance="high"
             Text="Dependencies (IDE): $(MTCapsLibsDir)" />

    <!-- FILL THE VIEW FROM THE STORES (L16, decided on the Windows box
         2026-09-02). The IDE path resolves the dependency directory and, until
         now, nothing ever put anything in it: acquisition runs only from the
         driver. On a capability set whose view has not been built, or whose
         view was pruned by the GC, that is not a Link error: the view carries
         the dependency HEADERS as well, so the build dies at ClCompile with
         `'tiffio.h' file not found`, which names nothing a reader can act on.

         Before L16 the only fix was to BUILD the dependencies here, and a
         forty-minute FFmpeg compile starting because somebody pressed F7 is
         worse than the failure. A store is a built unit and a view is a copy of
         stores, so the fix is now a file copy: 317 files, measured at 3 s, no
         compiler, and no possibility of a long build appearing by surprise.

         It runs on EVERY IDE build, not only when the view is missing. A stamp
         hit says the STORE is valid and says nothing about the view, which is the same
         reason the producers sync from a `finally` rather than at the end.

         ContinueOnError: this step can only ADD to the view. If it fails, the
         build is exactly as well off as it was before the step existed, and it
         must not be the thing that breaks an IDE build that would have worked. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MTCapsEngineDir)\platform\Windows\sync-deps-view.ps1&quot; -CapsFile &quot;$(MTCapsResolvedRoot)\MTEngineCaps.xcconfig&quot; -OutLibDir &quot;$(MTCapsLibsDir)&quot;"
          Condition="Exists('$(MTCapsResolvedRoot)\MTEngineCaps.xcconfig')"
          ContinueOnError="WarnAndContinue"
          StandardOutputImportance="high" />

    <!-- The capability defines as an ITEM LIST. See the note on
         PreprocessorDefinitions below for why the property alone will not do. -->
    <ItemGroup>
      <MTCapsIdeDefineItem Include="$(MTCapsIdeDefinesUnescaped)" />
    </ItemGroup>

    <!-- The point of the whole file. Modifying ClCompile metadata inside a
         target that runs before the ClCompile task DOES reach the compiler. -->
    <ItemGroup>
      <ClCompile>
        <!-- @(MTCapsIdeDefineItem), not $(MTCapsIdeDefines), and the two are
             not interchangeable. MSBuild escapes the result of a property
             function, so the `;` in the property is `%3B` and the whole
             capability set expands as ONE token. The MSVC CL task then emits it
             as a single quoted /D and every capability macro but the first is
             simply not defined. This engine project is spared today only
             because it compiles with ClangCL, whose task splits the value
             anyway; the apps use the MSVC task, and the identical line in
             MTEngineApp.targets silently built a DummyApp with no imgui test
             engine in it (found on Windows, 2026-09-02). Depending on the
             toolset for that is not a property worth keeping.

             APPENDED, not prepended, and the order is the whole point. The
             .vcxproj hardcodes a legacy set of BARE defines
             (MT_ENABLE_LIBTIFF;MT_ENABLE_LIBWEBP;MT_ENABLE_LIBAVIF;
             MT_ENABLE_LIBRAW;MT_ENABLE_FFMPEG;MT_ENABLE_LCMS2;...), and a bare
             /D NAME means 1. On the command line the caps come from
             MTEngineCaps.props, which is imported BEFORE the .vcxproj body, so
             the .vcxproj's own group lands first and the caps last, and the
             caps win. Prepending here inverted that: the command line read
             '/D MT_ENABLE_LIBTIFF=0 ... /D MT_ENABLE_LIBTIFF', the last one
             wins, and an IDE build compiled codec sources the manifest had
             switched OFF (it then failed on tiffio.h / webp/decode.h, which is
             how this was found). Appending reproduces the command-line order. -->
        <PreprocessorDefinitions>%(ClCompile.PreprocessorDefinitions);@(MTCapsIdeDefineItem)</PreprocessorDefinitions>
        <!-- The dependency headers too. The .vcxproj names the image-codecs and
             ffmpeg include dirs off $(MTCapsLibsDir) in an ItemDefinitionGroup,
             which MSBuild evaluates BEFORE any target runs, and on the IDE path
             that property is still empty there, so both entries evaluated to
             bogus relative paths and an IDE build failed on tiffio.h and
             webp/decode.h. Re-add them here, where the property has a value. -->
        <AdditionalIncludeDirectories>$(MTCapsIncludeDir);$(MTCapsLibsDir)\image-codecs\include;$(MTCapsLibsDir)\ffmpeg\include;%(ClCompile.AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ClCompile>
      <!-- The keyed directory goes FIRST. It used to matter because
           platform\Windows\libs still held tracked prebuilts that could shadow
           a freshly built archive; those are deleted (item 9, 2026-09-02) and
           this is now simply the only bucket a link should ever read. -->
      <Link>
        <AdditionalLibraryDirectories>$(MTCapsLibsDir);%(Link.AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      </Link>
    </ItemGroup>
  </Target>
</Project>
